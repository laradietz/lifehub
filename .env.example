# --- General ---
ENVIRONMENT=development

# --- Backend / Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Base de datos ---
POSTGRES_USER=lifehub
POSTGRES_PASSWORD=lifehub
POSTGRES_DB=lifehub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS (lista JSON de origenes permitidos) ---
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# --- Almacenamiento de archivos (Fase 5, MinIO en desarrollo) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=lifehub
S3_SECRET_KEY=lifehub12345
S3_BUCKET_NAME=lifehub
S3_REGION=us-east-1

# --- Email (opcional) ---
# Si no se configura SMTP_HOST, los emails (reset de contraseña, invitaciones a
# hogar, notificaciones) solo se loguean -- sirve para desarrollo sin proveedor.
# Cualquier proveedor que hable SMTP sirve (Gmail, Amazon SES, Postmark, Mailgun...).
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASSWORD=password
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=no-reply@tu-dominio.com
# SMTP_FROM_NAME=Life Under Control

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api
# Mismo origen que VITE_API_URL pero sin la ruta /api: lo usa nginx (producción)
# para la directiva connect-src de su Content-Security-Policy.
API_ORIGIN=http://localhost:8000
