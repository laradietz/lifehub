# Build de producción: compila los estáticos y los sirve con nginx (sin el
# servidor de desarrollo de Vite). El backend con el que habla el bundle final
# se fija en build time via VITE_API_URL (Vite embebe las env VITE_* en el JS
# compilado, no se pueden cambiar despues en runtime sin recompilar).
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# nginxinc/nginx-unprivileged: misma imagen oficial de nginx pero configurada para
# correr como usuario no-root (escucha en :8080, no en :80/root) — ver AUDITORIA.md,
# hallazgo S6.
FROM nginxinc/nginx-unprivileged:1.27-alpine

# API_ORIGIN se usa en la CSP de nginx.conf.template (connect-src) via envsubst
# automático del entrypoint oficial de nginx al arrancar el contenedor.
ENV API_ORIGIN=http://localhost:8000

COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
